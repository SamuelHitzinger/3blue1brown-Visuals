# Server-only. Copy to backend/.env.local for local development.
# Optional alternate app build directory (absolute, or relative to backend cwd).
# FRONTEND_DIR=/absolute/path/to/frontend/site
# Enable real script + scene generation after agents:login and agents:check succeed.
VIDEO_GENERATOR=pi
AGENT_AUTH_MODE=subscription
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-6-astra
AGENT_THINKING=high
# Independent Pi conversation, same provider/login; thumbnails use low reasoning.
THUMBNAIL_MODEL=gpt-6.1-sol
# Course classification (Sol by default; Astra is also supported).
STUDY_PLAN_MODEL=gpt-6.1-sol
# Incremental lecture notes use the same provider/login and medium reasoning.
LECTURE_MODEL=gpt-6.1-sol
# Lecture visuals use AGENT_MODEL and the existing compiler/rendered review.
# Default: lectures.sqlite beside VIDEO_DB_PATH, inside its persistent volume.
# LECTURE_DB_PATH=/data/videos/lectures.sqlite
# Optional: reuse the validated scene source instead of emitting it twice.
# Default text preserves the original completion protocol; rollback with text.
# AGENT_SCENE_OUTPUT_MODE=validated-reference
# Supply exact timing constants from the host instead of asking the model to copy them.
# AGENT_SCENE_TIMING_MODE=host
# Scene inspection is always available; visual previews default on (two batches per scene).
# Docker includes Chromium. For local development, install Chromium and set its executable:
# SCENE_PREVIEW_CHROMIUM=/usr/bin/chromium
# Disable visual previews while retaining analytical inspection:
# SCENE_PREVIEW=0
# Docker sets this because its capability restrictions disallow Chromium's nested sandbox.
# Leave unset when running locally with a working Chromium sandbox.
# SCENE_PREVIEW_NO_SANDBOX=1
# API-key mode reads this key and ignores saved subscription credentials.
OPENAI_API_KEY=
# Local default: ~/.aha/pi; use the same directory for login and backend commands.
# PI_CODING_AGENT_DIR=/absolute/private/path/pi
# To reuse a local Pi login, set AGENT_PROVIDER=openai-codex and
# PI_CODING_AGENT_DIR=/home/your-user/.pi/agent. No credential copying is needed.
# Local default: backend/data/agents. Docker sets this to /data/agents/jobs.
# AGENT_DATA_DIR=/absolute/path/agent-jobs
# Deployment-only host directory; defaults to /srv/apps/3yellow3white-actions/agents.
# AGENT_STATE_DIR=/absolute/private/path/agent-state
ELEVENLABS_API_KEY=
# Direct lecture capture uses short, retryable audio clips. Default: elevenlabs.
# Set to deepgram and configure its key to use a different transcription service.
# LECTURE_TRANSCRIPTION_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# Optional provider language code; omitted means automatic language detection.
# LECTURE_TRANSCRIPTION_LANGUAGE=de
# Alexander - Smooth, Deep and Round (requires access on the runtime account)
ELEVENLABS_VOICE_ID=CQcj2MsUgZyAgfHH6yJV
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Local default is backend/.narration; production Compose manages its persistent mount.
# NARRATION_DATA_DIR=/absolute/private/path/narration
# Only for a backend bound to loopback during local development; ignored in production.
NARRATION_ALLOW_LOCAL=0
# Public browser origin for video and narration writes behind the production gateway.
# Must match exactly (scheme and host, no trailing slash); omit for local development.
# NARRATION_PUBLIC_ORIGIN=https://11.hackathon.ethz.ch

# Private phone receiver. `npm run phone:start` configures these for Tailscale Serve.
# Only forward this loopback receiver, never the anonymous desktop API, to a phone.
# CAPTURE_PORT=8081
# CAPTURE_PUBLIC_ORIGIN=https://your-computer.your-tailnet.ts.net:8443
# CAPTURE_DB_PATH=/absolute/private/path/lecture-capture.sqlite
