{
  "name": "3yellow3white",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared/animlib",
    "backend"
  ],
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "scripts": {
    "agents:login": "npm run agents:login --workspace @aha/backend",
    "agents:status": "npm run agents:status --workspace @aha/backend",
    "agents:check": "npm run agents:check --workspace @aha/backend",
    "agents:logout": "npm run agents:logout --workspace @aha/backend",
    "agents:thumbnails": "npm run agents:thumbnails --workspace @aha/backend --",
    "dev": "npm run dev --workspace animlib",
    "build": "npm run build --workspace animlib && npm run build:preview --workspace @aha/backend",
    "test": "npm run test --workspace animlib",
    "typecheck": "npm run typecheck --workspace animlib",
    "demo:build": "npm run demo:build --workspace animlib",
    "app:dev": "npm --prefix frontend/app run dev",
    "app:build": "npm --prefix frontend/app run build",
    "app:test": "npm --prefix frontend/app test",
    "backend:dev": "npm run build && npm run dev --workspace @aha/backend",
    "backend:start": "npm run build && npm run start --workspace @aha/backend",
    "backend:test": "npm run build && npm run test --workspace @aha/backend",
    "backend:typecheck": "npm run build && npm run typecheck --workspace @aha/backend"
  },
  "devDependencies": {
    "bun": "1.4.2"
  }
}
