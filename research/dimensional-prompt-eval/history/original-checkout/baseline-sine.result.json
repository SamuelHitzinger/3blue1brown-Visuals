      "captions": [
        {
          "start": 0.4,
          "end": 6,
          "text": "The blue sine curve peaks at one, bottoms at minus one, and repeats after"
        },
        {
          "start": 6,
          "end": 7.5,
          "text": "two pi."
        },
        {
          "start": 7.5,
          "end": 11.5,
          "text": "Now watch the teal copy as we double the input."
        },
        {
          "start": 11.5,
          "end": 17.1,
          "text": "Follow its peak and next zero as they move; compare their horizontal positions with"
        },
        {
          "start": 17.1,
          "end": 18.6,
          "text": "the blue landmarks."
        },
        {
          "start": 18.6,
          "end": 21.400000000000002,
          "text": "Both end halfway toward the vertical axis!"
        },
        {
          "start": 21.400000000000002,
          "end": 27,
          "text": "Twice the new x gives the old input, so the output stays the same."
        },
        {
          "start": 27,
          "end": 30.733333333333334,
          "text": "Sine of twice x compresses horizontally, not vertically."
        },
        {
          "start": 30.733333333333334,
          "end": 36.333333333333336,
          "text": "The amplitude remains one, but a full cycle now spans pi: half the period."
        }
      ],
