      "captions": [
        {
          "start": 0.4,
          "end": 5.2,
          "text": "This saddle is the surface z equals x squared minus y squared."
        },
        {
          "start": 5.2,
          "end": 10.733333333333334,
          "text": "Slice through the origin along the x direction, then the perpendicular y direction."
        },
        {
          "start": 10.733333333333334,
          "end": 13.533333333333335,
          "text": "Both curves belong to the same surface."
        },
        {
          "start": 13.533333333333335,
          "end": 15.133333333333335,
          "text": "Look at their bends."
        },
        {
          "start": 15.133333333333335,
          "end": 20.333333333333336,
          "text": "Take a moment to compare which section opens upward and which opens downward."
        },
        {
          "start": 23.333333333333336,
          "end": 27.333333333333336,
          "text": "The x section opens upward; the y section opens downward!"
        },
        {
          "start": 27.333333333333336,
          "end": 30.933333333333337,
          "text": "Starting at the origin, move along the positive axes."
        },
        {
          "start": 30.933333333333337,
          "end": 34.46666666666667,
          "text": "The x section rises with increasingly positive slope."
        },
        {
          "start": 34.46666666666667,
          "end": 38,
          "text": "The y section falls with increasingly negative slope."
        },
        {
          "start": 38,
          "end": 40,
          "text": "Both start with zero slope."
        }
      ],
