      "captions": [
        {
          "start": 0.4,
          "end": 5.866666666666667,
          "text": "This saddle’s two central slices follow perpendicular directions in the horizontal"
        },
        {
          "start": 5.866666666666667,
          "end": 7.366666666666667,
          "text": "plane."
        },
        {
          "start": 7.366666666666667,
          "end": 12.166666666666668,
          "text": "On the blue slice, y is zero, so z is x squared."
        },
        {
          "start": 12.166666666666668,
          "end": 17.366666666666667,
          "text": "On the gold slice, x is zero, so z is negative y squared."
        },
        {
          "start": 17.366666666666667,
          "end": 22.96666666666667,
          "text": "Compare the tangents as both points move from the origin toward positive x and"
        },
        {
          "start": 22.96666666666667,
          "end": 24.46666666666667,
          "text": "positive y."
        },
        {
          "start": 24.46666666666667,
          "end": 29.866666666666667,
          "text": "The blue tangent tilts uphill; the gold tangent tilts downhill, both increasingly"
        },
        {
          "start": 29.866666666666667,
          "end": 31.366666666666667,
          "text": "steeply."
        },
        {
          "start": 31.366666666666667,
          "end": 33.36666666666667,
          "text": "Their slopes start at zero."
        },
        {
          "start": 33.36666666666667,
          "end": 38.166666666666664,
          "text": "On the negative halves, slope signs reverse, but the bending does not."
        }
      ],
