      "captions": [
        {
          "start": 0.4,
          "end": 6,
          "text": "Here’s sine of x: one full cycle spans zero to two pi, with heights"
        },
        {
          "start": 6,
          "end": 8,
          "text": "from minus one to one."
        },
        {
          "start": 8,
          "end": 12.733333333333334,
          "text": "Watch corresponding landmarks slide to half their horizontal positions."
        },
        {
          "start": 12.733333333333334,
          "end": 15.133333333333335,
          "text": "Compare their heights as they move."
        },
        {
          "start": 15.133333333333335,
          "end": 17.133333333333333,
          "text": "Same heights, half the width!"
        },
        {
          "start": 17.133333333333333,
          "end": 22.733333333333334,
          "text": "In sine of two x, an x of pi over four supplies the input"
        },
        {
          "start": 22.733333333333334,
          "end": 27.133333333333333,
          "text": "pi over two, so the peak arrives halfway as far along."
        },
        {
          "start": 27.133333333333333,
          "end": 30.333333333333332,
          "text": "Every landmark arrives at half its old x."
        },
        {
          "start": 30.333333333333332,
          "end": 33.93333333333333,
          "text": "The period becomes pi, while the amplitude stays one."
        }
      ],
