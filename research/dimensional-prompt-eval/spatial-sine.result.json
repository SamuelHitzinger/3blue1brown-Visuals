  "scenes": [
    {
      "id": "beat-1",
      "index": 0,
      "assets": {},
      "duration": 34.734,
      "audio": {
        "id": "subtitle-clock-beat-1"
      },
      "narration": "Here’s sine of x: one full cycle spans zero to two pi, with heights from minus one to one. Watch corresponding landmarks slide to half their horizontal positions. Compare their heights as they move. Same heights, half the width! In sine of two x, an x of pi over four supplies the input pi over two, so the peak arrives halfway as far along. Every landmark arrives at half its old x. The period becomes pi, while the amplitude stays one.",
      "visualDescription": "Content needed: One continuous shared coordinate plane, x from 0 to 2π and y from −1 to 1 with margins. Begin with sin(x), then compress a corresponding copy horizontally into sin(2x), preserving landmark heights. Compare the origin, maximum, descending zero, minimum, and cycle endpoint. Keep the original graph visible. Reveal the input correspondence 2(π/4)=π/2 after the visual comparison, then the period π and unchanged amplitude 1. No title card. Subtitle narration; no explicit silent pause.\n",
      "words": [
        {
          "id": "beat-1.u1.w1",
          "text": "Here’s",
          "start": 0.4,
          "end": 0.8
        },
        {
          "id": "beat-1.u1.w2",
          "text": "sine",
          "start": 0.8,
          "end": 1.2
        },
        {
          "id": "beat-1.u1.w3",
          "text": "of",
          "start": 1.2,
          "end": 1.5999999999999996
        },
        {
          "id": "beat-1.u1.w4",
          "text": "x:",
          "start": 1.5999999999999996,
          "end": 2
        },
