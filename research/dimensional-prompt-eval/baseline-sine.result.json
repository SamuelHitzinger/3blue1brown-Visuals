      "captions": [
        {
          "start": 0.4,
          "end": 3.1999999999999997,
          "text": "Start with one cycle of sine x."
        },
        {
          "start": 3.1999999999999997,
          "end": 7.199999999999999,
          "text": "Its peak is one, and its trough is negative one."
        },
        {
          "start": 7.199999999999999,
          "end": 8.799999999999999,
          "text": "Now double the input."
        },
        {
          "start": 8.799999999999999,
          "end": 14.399999999999999,
          "text": "To reach the old peak, the doubled input must equal pi over two, so"
        },
        {
          "start": 14.399999999999999,
          "end": 17.599999999999998,
          "text": "x only needs to be pi over four."
        },
        {
          "start": 17.599999999999998,
          "end": 22.799999999999997,
          "text": "Watch the peak, zero, and trough move to half their old horizontal positions."
        },
        {
          "start": 22.799999999999997,
          "end": 25.199999999999996,
          "text": "Compare their heights as they move."
        },
        {
          "start": 25.199999999999996,
          "end": 26.999999999999996,
          "text": "Nothing changes vertically!"
        },
        {
          "start": 26.999999999999996,
          "end": 30.999999999999996,
          "text": "The cycle now finishes at pi instead of two pi."
        },
        {
          "start": 30.999999999999996,
          "end": 36.199999999999996,
          "text": "Sine of two x has half the period, but the same amplitude: one."
        }
      ],
