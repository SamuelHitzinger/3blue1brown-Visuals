  "scenes": [
    {
      "id": "beat-1",
      "index": 0,
      "assets": {},
      "duration": 37,
      "audio": {
        "id": "subtitle-clock-beat-1"
      },
      "narration": "Start with one cycle of sine x. Its peak is one, and its trough is negative one. Now double the input. To reach the old peak, the doubled input must equal pi over two, so x only needs to be pi over four. Watch the peak, zero, and trough move to half their old horizontal positions. Compare their heights as they move. Nothing changes vertically! The cycle now finishes at pi instead of two pi. Sine of two x has half the period, but the same amplitude: one.",
      "visualDescription": "Content needed: One continuous shared coordinate graph, initially showing y = sin(x) for 0 ≤ x ≤ 2π, with heights ±1 identified. Retain this blue reference throughout. Introduce a teal copy and compress its first cycle horizontally using (t, sin(t)) → (t/2, sin(t)). Track the peak, descending zero, trough, and cycle endpoint; retain their heights. At the peak explanation, briefly show 2x = π/2 → x = π/4 beside the corresponding peak guides. Remove this calculation after its use. During “Watch” and “Compare,” show the compression without conclusion captions or period brackets. At Reveal, confirm unchanged heights, then mark the original period 2π and new period π. Extend the teal curve through its second cycle to x = 2π. Keep both curves, amplitude reference, and period spans visible. No title card or explicit silence.\n",
      "words": [
        {
          "id": "beat-1.u1.w1",
          "text": "Start",
          "start": 0.4,
          "end": 0.8
        },
        {
          "id": "beat-1.u1.w2",
          "text": "with",
          "start": 0.8,
          "end": 1.2
        },
        {
          "id": "beat-1.u1.w3",
          "text": "one",
          "start": 1.2,
          "end": 1.5999999999999996
        },
        {
          "id": "beat-1.u1.w4",
          "text": "cycle",
          "start": 1.5999999999999996,
          "end": 2
