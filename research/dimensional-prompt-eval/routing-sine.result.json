  "scenes": [
    {
      "id": "beat-1",
      "index": 0,
      "assets": {},
      "duration": 36.9,
      "audio": {
        "id": "subtitle-clock-beat-1"
      },
      "narration": "Start with sine of x. Watch a copy compress horizontally: compare its peak, downward zero crossing, and cycle endpoint with the originals. Each lands at half the original x coordinate. Sine of two x reaches the same input using half as much x. The peak moves from pi over two to pi over four, but its height stays one. The trough still reaches minus one: amplitude stays one. A full cycle now ends at pi instead of two pi. Half the period, twice as fast.",
