frontend/site/** linguist-generated=true -diff -whitespace
backend/prompts/scenegen/*.md text eol=lf
# Preserve byte-for-byte model output used by visual review provenance hashes.
docs/demos/rna-auto/scene-*.js -text
docs/demos/rna-verify-first/scene-*.js -text
docs/demos/rna-spatial-prompts/scene-*.js -text
docs/demos/spatial-proofs/*.js -text
# Preserve public scientific inputs byte-for-byte, including fixed-width padding.
shared/animlib/demo/proofs/data/*.pdb -text -whitespace
shared/animlib/demo/proofs/data/*.cif -text -whitespace
shared/animlib/demo/proofs/data/*.json -text
# Content-addressed native asset blobs must survive checkout byte-for-byte.
shared/animlib/fixtures/**/*.bin binary
shared/animlib/fixtures/**/*.pdb -text -whitespace
shared/animlib/fixtures/**/*.cif -text -whitespace

# Release scripts run in Linux CI/containers and WSL on Windows.
*.sh text eol=lf
